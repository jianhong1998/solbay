# =======================================================
# Install Stage
# =======================================================
FROM node:22.14.0-slim AS install
WORKDIR /apps/server

COPY ./rds-global-bundle.pem .
COPY package*.json .
RUN npm ci --omit=dev

# =======================================================
# DB Migrate Build Stage
# =======================================================
FROM node:22.14.0-slim AS db-migrate-build
WORKDIR /apps/server

COPY package*.json .
RUN npm ci

COPY . .
RUN npm run build

# =======================================================
# DB Migrate Final Stage
# =======================================================
# FROM node:22.14.0-slim
FROM install
WORKDIR /apps/server

COPY --from=db-migrate-build /apps/server/.env ./
COPY --from=db-migrate-build /apps/server/dist ./dist

CMD ["npm", "run", "migration:run"]