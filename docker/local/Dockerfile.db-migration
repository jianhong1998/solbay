# =======================================================
# Install Stage
# =======================================================
FROM node:22.14.0-slim AS install
WORKDIR /apps/server

COPY package*.json .
RUN npm ci --omit=dev

# =======================================================
# DB Migrate Build Stage
# =======================================================
FROM node:22.14.0-slim AS db-migrate-build
WORKDIR /apps/server

COPY package*.json .
RUN npm ci

COPY . .
RUN npm run build

# =======================================================
# DB Migrate Final Stage
# =======================================================
FROM node:22.14.0-slim
WORKDIR /apps/server

COPY --from=install /apps/server/node_modules ./node_modules
COPY --from=db-migrate-build /apps/server/package*.json ./
COPY --from=db-migrate-build /apps/server/rds-global-bundle.pem ./
COPY --from=db-migrate-build /apps/server/.env ./
COPY --from=db-migrate-build /apps/server/dist ./dist

CMD ["npm", "run", "migration:run"]