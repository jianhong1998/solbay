# ==================================================
# Install Stage
# ==================================================
FROM --platform=$TARGETPLATFORM node:22.15.0-slim AS base
WORKDIR /apps
COPY ./rds-global-bundle.pem .
WORKDIR /apps/server
COPY package*.json .
RUN npm ci --omit=dev

# ==================================================
# Build Stage
# ==================================================
FROM --platform=$TARGETPLATFORM node:22.15.0-slim AS server-build
WORKDIR /apps/server
COPY package*.json .
RUN npm ci
COPY . .
RUN npm run build:swc


# ==================================================
# Final Stage
# ==================================================
FROM --platform=$TARGETPLATFORM base
WORKDIR /apps/server
COPY --from=server-build /apps/server/dist ./dist
CMD [ "sh", "-c", "node -r dotenv/config dist/main" ]
