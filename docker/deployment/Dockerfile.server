# ==================================================
# Install Stage
# ==================================================
FROM node:22.15.0-slim AS install
WORKDIR /apps/server

COPY package*.json .
RUN npm ci --omit=dev

# ==================================================
# Build Stage
# ==================================================

FROM node:22.15.0-slim AS server-build
WORKDIR /apps/server

COPY package*.json .
RUN npm ci

COPY ./ap-southeast-1-bundle.pem .
COPY . .

# Sample from local dockerfile

FROM node:22.14.0-slim
WORKDIR /apps/server

COPY package*.json .
RUN npm ci

COPY ./ap-southeast-1-bundle.pem .
COPY . .

CMD [ "node", "-r dotenv/config", "dist/src/main" ]
