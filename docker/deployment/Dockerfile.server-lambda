# =======================================================
# Install Stage
# =======================================================
FROM node:22.15.0-slim AS install
WORKDIR /usr/apps
COPY ./rds-global-bundle.pem .

WORKDIR /usr/apps/server
COPY package*.json .
RUN npm ci --omit=dev


# =======================================================
# Build Stage
# =======================================================
FROM node:22.15.0-slim AS build
WORKDIR /usr/apps/server
COPY package*.json .
RUN npm ci

COPY . .
RUN npm run build:swc
# COPY ./src/emails/templates ./dist/emails/templates


# =======================================================
# Final Stage
# =======================================================
FROM --platform=linux/arm64 public.ecr.aws/lambda/nodejs:22-arm64 AS final
WORKDIR ${LAMBDA_TASK_ROOT}

COPY --from=install /usr/apps/server/node_modules ./node_modules
COPY --from=install /usr/apps/rds-global-bundle.pem ../rds-global-bundle.pem
COPY --from=build /usr/apps/server/dist ./dist

CMD ["dist/lambda-main.handler"]